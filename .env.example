# Copy to .env and fill in. All values are optional except API_KEY.

# --- HTTP / core ---
PORT=3000
NODE_ENV=development
# Shared key required in the X-API-Key header on every route except GET /api/watcher/health.
API_KEY=change-me
# libSQL/SQLite URL; the parent directory is created on startup.
DATABASE_URL=file:./data/tether-watcher.db
# Echoed in every delivery payload as networkMode.
NETWORK_MODE=mainnet
# error | warn | info | debug
LOG_LEVEL=info

# --- TRC20 (TRON) ---
TRC20_ENABLED=true
# Blocks are scanned only once this many confirmations exist.
TRC20_CONFIRMATIONS=20
TRC20_TOKEN_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRC20_DECIMALS=6
# First height on a fresh database; unset = start at the confirmation-safe head.
# TRC20_START_BLOCK=65000000
TRONGRID_URL=https://api.trongrid.io
# Optional but recommended; raises TronGrid rate limits.
TRON_API_KEY=

# --- BEP20 (BNB Smart Chain) ---
BEP20_ENABLED=true
BEP20_CONFIRMATIONS=12
BEP20_TOKEN_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BEP20_DECIMALS=18
# BEP20_START_BLOCK=40000000
# Must be archive-capable when START_BLOCK requires a deep catch-up.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# --- Scanner ---
# Sleep between polls when the scanner is caught up with the safe head.
SCANNER_IDLE_INTERVAL_MS=3000

# --- Delivery worker ---
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=20
WORKER_HTTP_TIMEOUT_MS=5000
# First retry delay; doubles per attempt, capped at one hour.
WORKER_BACKOFF_BASE_MS=2000

# --- Retention ---
# Days to keep DELIVERED / DEAD_LETTER rows (live rows are never pruned).
DELIVERY_RETENTION_DAYS=30
PRUNE_INTERVAL_MS=86400000
